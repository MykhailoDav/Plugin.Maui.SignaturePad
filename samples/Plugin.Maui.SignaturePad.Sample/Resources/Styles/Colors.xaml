<?xml version="1.0" encoding="UTF-8" ?>
<!-- The palette: emerald, as the logo, with green-tinted neutrals. Each color has a dark theme variant with the "Dark"
     suffix. Android also reads Platforms/Android/Resources/values/colors.xml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Color x:Key="Primary">#047857</Color>
  <Color x:Key="PrimaryDark">#34D399</Color>
  <Color x:Key="OnPrimary">#FFFFFF</Color>
  <Color x:Key="OnPrimaryDark">#052E1C</Color>

  <Color x:Key="Surface">#FFFFFF</Color>
  <Color x:Key="SurfaceDark">#0F1512</Color>
  <Color x:Key="Card">#F1F6F3</Color>
  <Color x:Key="CardDark">#18211C</Color>
  <Color x:Key="Outline">#D3DED7</Color>
  <Color x:Key="OutlineDark">#2E3B34</Color>

  <Color x:Key="Text">#16201A</Color>
  <Color x:Key="TextDark">#E6EEE9</Color>
  <Color x:Key="TextMuted">#5B6B62</Color>
  <Color x:Key="TextMutedDark">#9FB0A6</Color>

  <!-- The pads: white in the light theme and dark in the dark one, where the ink is shown light. -->
  <Color x:Key="Pad">#FFFFFF</Color>
  <Color x:Key="PadDark">#1A241F</Color>
  <Color x:Key="PadLine">#C9D5CE</Color>
  <Color x:Key="PadLineDark">#3A4A41</Color>
  <Color x:Key="PadPlaceholder">#93A39A</Color>
  <Color x:Key="PadPlaceholderDark">#6F8077</Color>
  <Color x:Key="InkDark">#F2F7F4</Color>

  <!-- Exported images are previewed on paper in both themes, as they print. -->
  <Color x:Key="Paper">#FFFFFF</Color>

</ResourceDictionary>
