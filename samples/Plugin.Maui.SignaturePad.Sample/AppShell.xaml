<?xml version="1.0" encoding="UTF-8" ?>
<!-- Each tab shows one way to use the pad. Shell creates the pages through dependency injection (see MauiProgram). -->
<Shell x:Class="Plugin.Maui.SignaturePad.Sample.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Plugin.Maui.SignaturePad.Sample.Pages"
       Title="Signature Pad"
       FlyoutBehavior="Disabled">

  <TabBar>
    <ShellContent Title="Sign" Icon="tab_sign.png" Route="sign" ContentTemplate="{DataTemplate pages:SignPage}" />
    <ShellContent Title="Ink" Icon="tab_ink.png" Route="ink" ContentTemplate="{DataTemplate pages:InkPage}" />
    <ShellContent Title="Export" Icon="tab_export.png" Route="export" ContentTemplate="{DataTemplate pages:ExportPage}" />
    <ShellContent Title="Data" Icon="tab_data.png" Route="data" ContentTemplate="{DataTemplate pages:DataPage}" />
    <ShellContent Title="Form" Icon="tab_form.png" Route="form" ContentTemplate="{DataTemplate pages:FormPage}" />
  </TabBar>

</Shell>
